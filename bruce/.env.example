# Configure at least one chat platform. Each platform is enabled by setting all
# of its variables and disabled by leaving all of them unset.

# Twitch chat
TC_USERNAME=your_bot_username
TC_PASSWORD=your_twitch_chat_token
CHANNEL=your_channel

# YouTube live chat (YouTube Data API v3 key with the API enabled in Google Cloud)
# YT_API_KEY=your_youtube_data_api_key
# Either the broadcast's video id (the v= parameter of its watch URL) ...
# YT_VIDEO_ID=dQw4w9WgXcQ
# ... or the channel id, whose current live broadcast is looked up at start-up.
# YT_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# Minimum time between chat polls; each poll costs 5 of the 10,000 daily quota units.
# YT_POLL_INTERVAL_MS=5000

BRUCE_DB_PATH=sqlite:games.db
# BRUCE_LOG=bruce.log
