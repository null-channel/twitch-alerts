# Register your own confidential application at https://dev.twitch.tv/console/apps.
# Run `cargo run -p twitch_alerts -- authorize` once, then run the server.
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_TOKEN_FILE=twitch-tokens.json
# Must exactly match an OAuth redirect URL in your Twitch application settings.
TWITCH_REDIRECT_URL=http://localhost:3000/auth/twitch/callback
# Legacy alternative (does not renew automatically):
# ACCESS_TOKEN=your_twitch_access_token
# External token-service alternative:
# OAUTH2_SERVICE_URL=https://your-token-service.example/token
# OAUTH2_SERVICE_KEY=your_service_bearer_key
# OAUTH2_SERVICE_POINTER=/access_token
# OAUTH2_SERVICE_REFRESH=30
OPENAI_KEY=your_openai_api_key
OPENAI_MODEL=gpt-6-luna
CHANNEL_LOGIN=your_channel
DB_PATH=alerts.db
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
WEBSOCKET_HOST=localhost
WEBSOCKET_PORT=9000
# FRONTEND_ASSETS=/path/to/twitch_alerts/src/frontend/assets
# TWITCH_ALERTS_LOG=twitch_alerts.log
