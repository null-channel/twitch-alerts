{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "xo hooks claude-code post-task",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "command": "xo hooks claude-code post-todo",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "TaskCreate|TaskUpdate"
      },
      {
        "hooks": [
          {
            "command": "xo hooks claude-code post-tool-use",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "xo hooks claude-code post-tool-use",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|NotebookEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "xo hooks claude-code pre-task",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "command": "xo hooks claude-code pre-tool-use",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "xo hooks claude-code session-end",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "xo hooks claude-code session-start",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "xo hooks claude-code stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "xo hooks claude-code user-prompt-submit",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
